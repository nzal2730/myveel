{
  "name": "myveel",
  "version": "1.0.0",
  "description": "Smart Multi-Vehicle Care & Garage Management System",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "start": "node server/dist/index.js",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "prisma:generate": "prisma generate --schema server/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema server/prisma/schema.prisma --skip-generate",
    "deploy:build": "npm run prisma:generate && npm run build",
    "deploy:start": "npm run prisma:push && npm start",
    "test": "node server/tests/system.test.js"
  },
  "dependencies": {
    "@types/node": "^20.17.0",
    "prisma": "^5.21.1",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
