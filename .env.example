# ========================================================
# MYVEEL ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env or paste into Render Dashboard -> Environment
# ========================================================

# Server Port (Render sets this automatically, default 10000 on Render)
PORT=5000

# Database URL
# For SQLite on Render (ephemeral or with Render Disk mounted at /var/data):
DATABASE_URL="file:./prisma/dev.db"

# JWT Authentication Secret
JWT_SECRET=replace_with_a_long_random_secret_key_for_production

# JWT Expiration Period
JWT_EXPIRES_IN=7d

# 32-character Hex key for AES-256 Driving Licence encryption
ENCRYPTION_KEY=a1b2c3d4e5f60718293a4b5c6d7e8f90

# Node Environment
NODE_ENV=production

# Upload directory for vehicle photos and documents
UPLOAD_DIR=./uploads

# Frontend URL (optional, for CORS)
FRONTEND_URL=http://localhost:3000
