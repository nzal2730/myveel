# MyVeel Environment Configuration
PORT=5000

# SQLite via Prisma (relative to server/prisma)
DATABASE_URL="file:./dev.db"

# Replace with long random values before deploying
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=replace_with_32_hex_characters

NODE_ENV=development
UPLOAD_DIR=./uploads
FRONTEND_URL=http://localhost:3000
